{
  "name": "fucking-opencode",
  "version": "0.1.7",
  "description": "OpenAI-compatible gateway to OpenCode free-tier models (no account required), self-adapting to gate changes",
  "main": "server.js",
  "bin": {
    "fucking-opencode": "server.js"
  },
  "scripts": {
    "start": "bun server.js",
    "test": "bun test test/*.test.js",
    "drill": "bun gate-drill.js",
    "verify": "bun verify.js",
    "verify:quick": "bun verify.js --quick",
    "fingerprint": "bun transport-fingerprint.js",
    "fingerprint:check": "bun transport-fingerprint.js --check",
    "start:node": "node server.js",
    "test:node": "node --test test/*.test.js",
    "drill:node": "node gate-drill.js"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "files": [
    "server.js",
    "identity.js",
    "token-budget.js",
    "verify.js",
    "gate-drill.js",
    "README.md",
    "AGENTS.md",
    "install.sh",
    "THIRD_PARTY_NOTICES.md",
    "egress-proxy.js",
    "transport-fingerprint.js",
    "transport-baseline.json",
    "tunnel-doctor.sh",
    "proxy.js",
    "panel-avatar.png",
    "panel.js",
    "panel-settings.js",
    "config.js",
    "model-groups.js",
    "socks-bridge.js",
    "warp.js",
    "warp-farm.js",
    "warp-farm/main.go",
    "warp-farm/bind.go",
    "warp-farm/exit.go",
    "warp-farm/freebind_linux.go",
    "warp-farm/freebind_other.go",
    "warp-farm/registrar.go",
    "warp-farm/socks5.go",
    "warp-farm/go.mod",
    "warp-farm/go.sum",
    "warp-farm/LICENSE",
    "warp-farm/NOTICE.md",
    "stats.js",
    "compat.js",
    "audit.js",
    "autoheal.js",
    "backup.js",
    "dashboard-api.js",
    "diagnostics.js",
    "notify.js",
    "observability.js",
    "ops.js",
    "retention.js",
    "selftest.js",
    "fleet.js",
    "probe.js",
    "fleet-health-monitor.js",
    "fleet-orchestrator.js",
    "fleet-panel-routes.js",
    "fleet-autoactions.js"
  ],
  "keywords": [
    "opencode",
    "openai",
    "gateway",
    "proxy",
    "free",
    "llm",
    "9router",
    "cursor",
    "continue",
    "vscode"
  ],
  "license": "AGPL-3.0-or-later"
}
